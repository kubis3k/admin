# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/gastro_admin"

# Auth.js v5 secret — vygeneruj: npx auth secret
AUTH_SECRET="zmen-me-na-neco-nahodneho"

# Veřejná URL adminu. Na Vercelu netřeba, jinde v produkci POVINNÉ.
# Nenastavuj místo toho AUTH_TRUST_HOST — magic link by se pak skládal
# z hlavičky Host/X-Forwarded-Host, kterou může podvrhnout útočník.
AUTH_URL="https://admin.example.com"

# SMTP server pro magic link (Nodemailer provider). Bez EMAIL_SERVER se mimo
# produkci odkaz jen vypíše do konzole (viz README — Přihlášení); v produkci
# (včetně `next build`) je povinný.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="admin@example.com"
